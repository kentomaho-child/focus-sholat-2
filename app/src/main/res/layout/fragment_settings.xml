<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Location Section -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="📍 Lokasi" android:textSize="14sp" android:textStyle="bold"
            android:textColor="@color/primary" android:layout_marginBottom="4dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" app:cardElevation="2dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <RadioGroup android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <RadioButton android:id="@+id/radio_gps" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="wrap_content"
                        android:text="GPS Otomatis" android:checked="true" />
                    <RadioButton android:id="@+id/radio_manual" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="wrap_content"
                        android:text="Kota Manual" />
                </RadioGroup>

                <LinearLayout android:id="@+id/layout_manual_city"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="8dp"
                    android:visibility="gone" android:gravity="center_vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:hint="Nama Kota"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_city_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_save_city"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Simpan" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Prayer Times Section -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🕌 Waktu Sholat" android:textSize="14sp" android:textStyle="bold"
            android:textColor="@color/primary" android:layout_marginBottom="4dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" app:cardElevation="2dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <!-- Fajr -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="Subuh (Fajr)" android:textSize="15sp" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_fajr" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:checked="true" />
                </LinearLayout>

                <!-- Dhuhr -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="Dzuhur" android:textSize="15sp" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_dhuhr" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:checked="true" />
                </LinearLayout>

                <!-- Asr -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="Ashar" android:textSize="15sp" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_asr" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:checked="true" />
                </LinearLayout>

                <!-- Maghrib -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="Maghrib" android:textSize="15sp" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_maghrib" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:checked="true" />
                </LinearLayout>

                <!-- Isha -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="Isya" android:textSize="15sp" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_isha" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:checked="true" />
                </LinearLayout>

                <!-- Prayer Duration -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Durasi Blokir per Sholat" android:textSize="14sp"
                    android:layout_marginTop="16dp" android:layout_marginBottom="4dp" />
                <TextView android:id="@+id/tv_prayer_duration_value"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="30 menit" android:textSize="13sp" android:textColor="@color/primary" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_prayer_duration"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:valueFrom="15" android:valueTo="60" android:value="30"
                    android:stepSize="5" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Notification Section -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🔔 Notifikasi" android:textSize="14sp" android:textStyle="bold"
            android:textColor="@color/primary" android:layout_marginBottom="4dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" app:cardElevation="2dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Pengingat sebelum sholat" android:textSize="14sp"
                    android:layout_marginBottom="4dp" />
                <TextView android:id="@+id/tv_reminder_value"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="10 menit sebelum" android:textSize="13sp"
                    android:textColor="@color/primary" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_reminder"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:valueFrom="0" android:valueTo="30" android:value="10"
                    android:stepSize="5" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Security Section -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🔒 Keamanan" android:textSize="14sp" android:textStyle="bold"
            android:textColor="@color/primary" android:layout_marginBottom="4dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" app:cardElevation="2dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="PIN / Password" android:textSize="15sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Proteksi pengaturan dengan PIN"
                            android:textSize="12sp" android:alpha="0.7" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_pin" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Strict Mode" android:textSize="15sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Tidak bisa menonaktifkan tanpa PIN"
                            android:textSize="12sp" android:alpha="0.7" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_strict_mode" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
