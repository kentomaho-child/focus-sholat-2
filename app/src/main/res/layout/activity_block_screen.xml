<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/block_background">

    <!-- Mosque Icon -->
    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_mosque"
        app:tint="@color/primary"
        android:layout_marginBottom="24dp" />

    <!-- Blocked App Icon -->
    <ImageView
        android:id="@+id/iv_blocked_app_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_app_default"
        android:layout_marginBottom="8dp"
        android:alpha="0.5" />

    <TextView
        android:id="@+id/tv_blocked_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aplikasi diblokir"
        android:textSize="14sp"
        android:alpha="0.7"
        android:textColor="@android:color/white"
        android:layout_marginBottom="24dp" />

    <!-- Block Title -->
    <TextView
        android:id="@+id/tv_block_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Waktu Sholat Maghrib"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <!-- Block Message -->
    <TextView
        android:id="@+id/tv_block_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Saatnya sholat. Letakkan HP dan ambil wudhu 🕌"
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:alpha="0.9"
        android:layout_marginBottom="8dp" />

    <!-- Countdown Timer -->
    <TextView
        android:id="@+id/tv_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textSize="14sp"
        android:textColor="@android:color/white"
        android:alpha="0.7"
        android:visibility="gone"
        android:layout_marginBottom="40dp" />

    <!-- Back to Home Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_back"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="🏠 Kembali ke Beranda"
        style="@style/Widget.Material3.Button.TonalButton" />

    <!-- Emergency Override Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_emergency_override"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Override Darurat"
        style="@style/Widget.Material3.Button.TextButton"
        android:textColor="@android:color/white"
        android:alpha="0.7" />

</LinearLayout>
